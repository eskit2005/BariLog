# BariLog Environment Configuration Template
# Copy this file to .env and configure your local credentials

# Base64-encoded 256-bit secret key for HMAC-SHA JWT signing
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_here

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/bariLog
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# Server Port
PORT=8080
